# Files that run or are mounted inside Linux containers keep LF line
# endings, even on a Windows checkout with core.autocrlf=true. A CRLF
# shebang line fails with "bad interpreter".
*.sh         text eol=lf
Dockerfile   text eol=lf
*.conf       text eol=lf
*.template   text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
