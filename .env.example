# TableFlow — environment configuration TEMPLATE
#
#   cp .env.example .env
#
# .env is gitignored and must NEVER be committed. No passwords or secrets
# in version control.
#
# The values below are LOCAL DEVELOPMENT DEFAULTS ONLY. They are weak on
# purpose so the stack starts on a fresh clone. Change every password and
# generate a real JWT_SECRET before exposing this to any network.

# --- PostgreSQL ---
POSTGRES_DB=tableflow
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=change_me_in_dotenv
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- MongoDB ---
MONGO_DB=tableflow
MONGO_USER=dev_user
MONGO_PASSWORD=change_me_in_dotenv
MONGO_PORT=27017
MONGO_HOST=localhost

# --- Auth ---
# Generate your own before any non-local use:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev_only_secret_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Zero-downtime migration read-switch ---
# false = API reads reservations.guest_name (legacy)
# true  = API reads reservations.first_name / last_name (new)
# Flipping this is the SWITCH READ step. Rollback = flip back, no redeploy.
READ_NEW_NAME_FIELDS=false
