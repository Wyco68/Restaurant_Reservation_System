# TableFlow environment settings, example file.
#
#   cp .env.example .env
#
# .env is in .gitignore and must not be committed.
#
# These values are only for local development, so a new clone starts
# without changes. Change the passwords and make a real JWT_SECRET before
# using this anywhere else.

# PostgreSQL
POSTGRES_DB=tableflow
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=change_me_in_dotenv
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# MongoDB
MONGO_DB=tableflow
MONGO_USER=dev_user
MONGO_PASSWORD=change_me_in_dotenv
MONGO_PORT=27017
MONGO_HOST=localhost

# Redis response cache. Empty means no cache. The compose app profile sets
# it for the container; set redis://localhost:6379/0 to cache under uvicorn.
# Tests run without it (tests/test_cache.py turns it on for itself).
REDIS_URL=
REDIS_PORT=6379
CACHE_TTL_SECONDS=60

# Auth
# Required. The app does not start with this placeholder. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# App
APP_ENV=development
LOG_LEVEL=INFO
# text for a terminal, json for log collectors (the image defaults to json)
LOG_FORMAT=text
# Browser origins allowed to call the API directly (comma-separated).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Full stack (docker compose --profile app up -d)
# Host ports for the API and the web image.
API_PORT=8000
WEB_PORT=8080
# --profile monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# guest_name migration
# Phase the app starts in: legacy | dual_write | read_new | new_only
# It can be changed while running with PUT /api/v1/admin/migration, and is
# lowered at startup if the schema does not support it.
NAME_MIGRATION_PHASE=legacy
